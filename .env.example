# ============================================================
# EV Charging Pipeline — Environment Variables
# Copy this file to .env and fill in your local values.
# NEVER commit the .env file to Git.
# ============================================================

# -------------------- PostgreSQL --------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ev_charging
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password

# -------------------- Apache Kafka --------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_CHARGING_EVENTS=charging-events

# -------------------- Apache Spark --------------------
SPARK_MASTER=local[*]
SPARK_APP_NAME=ev-charging-pipeline

# -------------------- Apache Airflow --------------------
AIRFLOW_HOME=./orchestration
AIRFLOW__CORE__DAGS_FOLDER=./orchestration/dags

# -------------------- Data Paths --------------------
DATA_RAW_DIR=./data/raw
DATA_SAMPLE_DIR=./data/sample

# -------------------- Streamlit --------------------
STREAMLIT_SERVER_PORT=8501
